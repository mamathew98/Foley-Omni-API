# Copy to .env and fill in before `docker compose up`.
# Guests receive ACCESS_TOKEN. Keep ADMIN_TOKEN private.

ACCESS_TOKEN=change-me-guest-preview-token
ADMIN_TOKEN=change-me-admin-token-different

# Optional tuning
MAX_QUEUE_SIZE=10
MAX_VIDEO_DURATION_SEC=30.0
# CPU_OFFLOAD=false
# SAMPLE_STEPS=50
# SEED=103

# Paths inside the container (compose mounts host ./ckpts and ./storage)
CKPT_DIR=/app/ckpts
MODEL_CHECKPOINT=/app/ckpts/Foley-Omni/v2st.pth
STORAGE_DIR=/app/storage

# Local UI smoke only (run_ui_local.bat). Docker Compose forces SKIP_MODEL_LOAD=0
# so a local "1" in .env cannot disable inference inside the container.
# SKIP_MODEL_LOAD=1
